# The test servers' sshd: OpenSSH's defaults, with password sign-in on for the test users.
# The host key is chosen on the command line, and so are the key exchanges and keyboard-interactive
# sign-in through PAM, on the servers that have it (entrypoint.sh).
Port 22
# Tests connect many times at once; the default (10:30:100) drops some of them at random.
MaxStartups 100
AuthorizedKeysFile .ssh/authorized_keys
PubkeyAuthentication yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers shello shello-otp shello-2fa
# Each server is a jump host for the others (TestServers/README.md). OpenSSH's default, written out:
# Alpine's own sshd_config, which this file replaces, turns it off.
AllowTcpForwarding yes
PrintMotd yes
Subsystem sftp internal-sftp
