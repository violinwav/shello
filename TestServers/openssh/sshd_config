# The test server's sshd: OpenSSH's defaults, with password sign-in on for the test user.
# The host key is chosen on the command line (entrypoint.sh).
Port 22
# Tests connect many times at once; the default (10:30:100) drops some of them at random.
MaxStartups 100
AuthorizedKeysFile .ssh/authorized_keys
PubkeyAuthentication yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers shello
PrintMotd yes
Subsystem sftp internal-sftp
